{
 "about": "Regression baseline: what a correct run concluded on every recording this skill was tuned on. scripts/regress.py runs `auto` on each case whose input it finds and checks these expectations. The two synthetic clips ship with the repository; the other recordings are not distributed: put your copies in a folder and pass it as --media (file names are matched by the patterns in `match`). Numbers only, no audio.",
 "cases": [
  {
   "name": "broadcast_song",
   "file": "evals/restores-broadcast-song/files/broadcast_song.m4a",
   "args": [],
   "expect": [
    {"path": "plan.music.delimit.enabled", "eq": true, "why": "limited source (LRA 0.2 LU)"},
    {"path": "plan.music.antiphase.stems", "contains": "other", "why": "the planted anti-phase guitar layer"},
    {"path": "plan.music.band_ext.enabled", "eq": true, "why": "AAC band limit"},
    {"path": "verify.warns", "max": 0, "why": "all checks PASS"},
    {"path": "steps.band_ext.result_minus_target_db.*", "abs_max": 1.5, "why": "rebuilt top within 1.5 dB of the reference (pitfall 43)"}
   ]
  },
  {
   "name": "mc_crowd",
   "file": "evals/tames-crowd-in-mc/files/mc_crowd.m4a",
   "args": [],
   "expect": [
    {"path": "diagnosis.processing_segments.0.2", "eq": "speech", "why": "an MC clip is detected as speech"},
    {"path": "plan.speech.crowd.enabled", "eq": true, "why": "cheers louder than the talk"},
    {"path": "verify.warns", "max": 0, "why": "all checks PASS, words kept"}
   ]
  },
  {
   "name": "glico_broadcast",
   "match": ["*GLICO*", "*glico*"],
   "args": ["--content", "music", "--codec-repair", "off"],
   "expect": [
    {"path": "plan.music.delimit.enabled", "eq": true, "why": "a broadcast limiter (LRA 0.7 LU, PLR 8.8, crest 10.9)"},
    {"path": "plan.master.over1_max_pct", "eq": 8.0, "why": "limited source: loud master"},
    {"path": "verify.warns", "max": 0, "why": "all checks PASS"}
   ]
  },
  {
   "name": "mirror_audience",
   "match": ["*MIRROR*"],
   "args": ["--content", "music", "--artist", "ヒトリエ", "--title", "MIRROR"],
   "expect": [
    {"path": "diagnosis.reference.used", "endswith": "song.json", "why": "the studio version is looked up"},
    {"path": "diagnosis.reference_section.start_s", "approx": 32.5, "tol": 4, "why": "the preview's passage (chorus) found"},
    {"path": "diagnosis.reference_section.similarity", "min": 0.6, "why": "same song: 0.67 at calibration"},
    {"path": "plan.music.macro.enabled", "eq": true, "why": "open recording (LRA 9.9 LU)"},
    {"path": "verify.warns", "max": 0, "why": "all checks PASS"},
    {"path": "steps.band_ext.result_minus_target_db.*", "abs_max": 1.5, "why": "rebuilt top within 1.5 dB of the studio version"}
   ]
  },
  {
   "name": "mc14_talk",
   "match": ["*14*MC*", "*MC*14*"],
   "args": ["--content", "speech"],
   "expect": [
    {"path": "plan.speech.crowd.enabled", "eq": true, "why": "cheering 5.6 dB over the talk"},
    {"path": "verify.warns", "max": 0, "why": "crowd under the talk, words kept"}
   ]
  },
  {
   "name": "tsumiki_codec",
   "match": ["*積み木の人形*", "*tsumiki*"],
   "args": ["--content", "music"],
   "expect": [
    {"path": "diagnosis.codec_repair.codec_damage", "eq": true, "why": "MP3-style low-pass with a sparse band (pitfall 37)"},
    {"path": "plan.music.macro.enabled", "eq": true, "why": "open recording (LRA 18.7 LU)"},
    {"path": "verify.warns", "max": 0, "why": "all checks PASS"},
    {"path": "steps.band_ext.result_minus_target_db.*", "abs_max": 1.5, "why": "rebuilt top within 1.5 dB of the reference"},
    {"path": "diagnosis.reference.used", "info": true, "why": "no studio version on iTunes when the baseline was made"}
   ]
  },
  {
   "name": "tenohira_acoustic",
   "match": ["*テノヒラ*", "*tenohira*"],
   "args": ["--content", "music"],
   "expect": [
    {"path": "review.kinds", "contains": "applause", "why": "applause at 285-330 s"},
    {"path": "review.kinds", "contains": "arrangement", "why": "no drums: a stripped-down arrangement (pitfall 41)"},
    {"path": "steps.balance.0.drums_absent", "max": -30, "why": "balance moved nothing (no applause raised)"},
    {"path": "plan_used.music.dynamics.vocals.0", "eq": 1.0, "why": "the crest WARN fixed by the autofix: vocal compression off"},
    {"path": "verify.warns", "max": 0, "why": "all checks PASS after the autofix"},
    {"path": "steps.band_ext.result_minus_target_db.*", "abs_max": 1.5, "why": "no notch above a moving cut-off (pitfall 43)"}
   ]
  },
  {
   "name": "shatterdoll_dense",
   "match": ["*シャッタードール*", "*shatter*"],
   "args": ["--content", "music"],
   "expect": [
    {"path": "plan.music.delimit.enabled", "eq": false, "why": "dense, not limited: PLR 10.9 but crest 13.6 (pitfall 44)"},
    {"path": "verify.output.loudness.lra_lu", "min": 5.5, "why": "its 6.6 LU range kept"},
    {"path": "verify.warns", "max": 0, "why": "all checks PASS with no hand edits"},
    {"path": "steps.band_ext.result_minus_target_db.*", "abs_max": 1.5, "why": "rebuilt top within 1.5 dB of the studio version"}
   ]
  }
 ]
}
